{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>milo-os/.github:renovate-config"
  ],
  "flux": {
    "managerFilePatterns": [
      "/^config/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "description": "The testcontainers core and its modules release together",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/testcontainers/testcontainers-go{,/**}"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "groupName": "testcontainers",
      "groupSlug": "testcontainers"
    },
    {
      "description": "Patch releases of testcontainers move together in their own pull request, so they can open without approval",
      "matchManagers": [
        "gomod"
      ],
      "matchPackageNames": [
        "github.com/testcontainers/testcontainers-go{,/**}"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "testcontainers (patch)",
      "groupSlug": "testcontainers-patch"
    },
    {
      "description": "The CockroachDB operator and the cluster it runs move together. The cluster chart's version is also the CockroachDB version the storage tests run",
      "matchManagers": [
        "flux"
      ],
      "matchPackageNames": [
        "cockroachdb-operator-chart",
        "cockroachdb-chart"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "groupName": "cockroachdb",
      "groupSlug": "cockroachdb"
    },
    {
      "description": "Patch releases of the CockroachDB operator and cluster charts move together in their own pull request, so they can open without approval",
      "matchManagers": [
        "flux"
      ],
      "matchPackageNames": [
        "cockroachdb-operator-chart",
        "cockroachdb-chart"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "groupName": "cockroachdb (patch)",
      "groupSlug": "cockroachdb-patch"
    }
  ]
}
