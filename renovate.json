{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "k8s.io/kubernetes only builds against staging modules of the same release, so bump it, every pinned staging module and controller-runtime together",
      "matchManagers": ["gomod"],
      "matchPackageNames": [
        "k8s.io/**",
        "sigs.k8s.io/controller-runtime",
        "sigs.k8s.io/multicluster-runtime",
        "!k8s.io/klog/**",
        "!k8s.io/utils",
        "!k8s.io/kube-openapi"
      ],
      "groupName": "kubernetes",
      "groupSlug": "kubernetes"
    }
  ]
}
